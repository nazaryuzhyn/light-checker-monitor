BOT_TOKEN=

DATABASE_URL=postgresql+asyncpg://lcm:YOUR_PASSWORD@db:5432/lcm
POSTGRES_PASSWORD=

ESP_API_KEY=

# Seconds of ESP silence that count as a possible outage
PING_TIMEOUT=30

# The first group is the one the bot reports on
OUTAGE_GROUPS=["GPV3.2","GPV5.2"]

# Optional — override to follow a different oblenergo feed
# SCHEDULE_URL=https://raw.githubusercontent.com/yaroslav2901/OE_OUTAGE_DATA/main/data/Ternopiloblenerho.json
